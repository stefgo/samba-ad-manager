# A Samba AD domain controller for the development stack (compose.dev.yaml). Not an image
# to run a real domain on: the administrator password is in the compose file, and the
# entrypoint provisions or joins without asking.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# samba-ad-dc pulls the AD DC parts Debian has split out of `samba`. python3-samba is what
# samba-tool itself runs on, and what the database check script imports. bind9 is the DNS
# server of a domain on BIND9_DLZ and the whole of the secondary name server
# (compose.dev.bind.yaml); bind9-dnsutils has the nsupdate a DC registers its records with,
# and tdb-tools the tdbbackup that setting a domain up for BIND copies its database with.
# supervisor runs Samba the way the image of a real domain controller does, which is what
# the agent asks about its programs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        samba samba-ad-dc samba-ad-provision samba-dsdb-modules samba-vfs-modules \
        winbind krb5-user ldb-tools python3-samba ca-certificates iproute2 \
        bind9 bind9-dnsutils tdb-tools supervisor \
    && rm -rf /var/lib/apt/lists/* \
    # The packaged smb.conf is for a file server; provision and join write their own.
    && rm -f /etc/samba/smb.conf

# The agent, taken in the way an image of a real domain controller takes it in: copied out
# of the image that carries it. `sadm-client` is that image, built by compose.dev.yaml from
# docker/Dockerfile.client. Whether it runs is the entrypoint's to decide (SADM_AGENT).
COPY --from=sadm-client /opt/sadm-client /opt/sadm-client

COPY docker/dev/samba-entrypoint.sh docker/dev/ns-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/samba-entrypoint.sh /usr/local/bin/ns-entrypoint.sh

# What a DC answers on, for whoever reads the image: DNS, Kerberos, RPC, LDAP, SMB,
# kpasswd, LDAPS, the global catalog.
EXPOSE 53 53/udp 88 88/udp 135 389 389/udp 445 464 464/udp 636 3268 3269

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD samba-tool processes >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/samba-entrypoint.sh"]
