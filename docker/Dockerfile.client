# The SADM agent as something another image takes in. This image runs nothing: it holds
# /opt/sadm-client and that is all. A domain controller's image copies it:
#
#   COPY --from=ghcr.io/stefgo/sadm-client:latest /opt/sadm-client /opt/sadm-client
#
# What is in there: the Node runtime the agent was built for (bin/node), the agent and what
# it depends on, a start script (bin/sadm-client) and a supervisord program
# (supervisor.conf). What the target image has to bring: glibc and libstdc++ (any Debian
# has them) and Samba's Python modules, which the agent reads the local database with.

# Builder Stage
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy manifest files and registry config. Every workspace's manifest, because the lockfile
# names them all.
COPY package.json package-lock.json .npmrc ./
COPY shared/package.json shared/
COPY client/package.json client/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

# Install all dependencies (with GitHub Packages auth)
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci

COPY shared ./shared
COPY client ./client

RUN npm run build -w shared
RUN npm run build -w client

# What the agent runs on, and nothing of the server: only the two workspaces it consists
# of. A fresh tree rather than a pruned one -- pruning keeps what every workspace needs,
# the server's native modules among them.
RUN --mount=type=secret,id=npm_token \
    rm -rf node_modules && \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci --omit=dev -w shared -w client

ARG APP_VERSION=unknown
RUN echo "${APP_VERSION}" > client/dist/VERSION

# Assembled where it will live, so the links inside node_modules point at the same places
# there as here.
RUN mkdir -p /opt/sadm-client/bin /opt/sadm-client/shared /opt/sadm-client/client && \
    cp /usr/local/bin/node /opt/sadm-client/bin/node && \
    cp package.json /opt/sadm-client/ && \
    cp -a node_modules /opt/sadm-client/node_modules && \
    cp shared/package.json /opt/sadm-client/shared/ && cp -a shared/dist /opt/sadm-client/shared/dist && \
    cp client/package.json /opt/sadm-client/client/ && cp -a client/dist /opt/sadm-client/client/dist
COPY --chmod=755 docker/client/sadm-client /opt/sadm-client/bin/sadm-client
COPY docker/client/supervisor.conf /opt/sadm-client/supervisor.conf

# Started once where it will run: the base image of a domain controller, without Node and
# without anything of this build. What is published has passed through here.
FROM debian:trixie-slim AS smoke
ARG APP_VERSION=unknown
COPY --from=builder /opt/sadm-client /opt/sadm-client
RUN test "$(/opt/sadm-client/bin/sadm-client --version)" = "${APP_VERSION}"

FROM scratch
COPY --from=smoke /opt/sadm-client /opt/sadm-client
