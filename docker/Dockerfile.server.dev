# Development image of the server: dependencies and the shared library baked in, the
# sources mounted over them by compose.dev.yaml, `npm run dev -w server/backend` as the
# command there.
#
# node:22-bookworm rather than a slim base: better-sqlite3 has no prebuilt binary for every
# platform and Node release, and the full image carries the compiler it then falls back to.
FROM node:22-bookworm

# The server writes the address compose.dev.yaml's healthcheck asks only in a container --
# see server/backend/src/core/HealthFile.ts.
ENV SADM_CONTAINER=true

RUN apt-get update && \
    apt-get install -y --no-install-recommends sqlite3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Manifests first, so the dependency layer is cached until one of them changes.
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/
COPY shared/package.json shared/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm install

COPY shared ./shared
RUN npm run build -w shared

CMD ["bash"]
