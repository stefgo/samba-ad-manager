{
    "name": "sadm-client",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "prebuild": "rimraf dist",
        "start": "tsx src/index.ts",
        "dev": "tsx watch --conditions development src/index.ts",
        "build": "tsc -p tsconfig.build.json && cp -r src/web/public dist/web/ && bash ../scripts/generate-version.sh dist/VERSION",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@sadm/shared": "*",
        "@fastify/static": "^10.1.3",
        "@fastify/websocket": "^11.3.0",
        "fastify": "^5.12.4",
        "ws": "^8.19.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.18.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3"
    }
}
