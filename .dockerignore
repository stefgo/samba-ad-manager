# Keep the build context small. Everything the builder stages need is copied
# explicitly (the manifests, .npmrc, shared/, client/, server/, scripts/) --
# anything generated or local-only just slows down the context upload and busts
# the layer cache.

# Dependencies -- reinstalled inside the image by `npm ci`
**/node_modules

# Build output -- regenerated by the builder stage
shared/dist
client/dist
server/backend/dist
server/dist

# Local runtime state and secrets -- must never end up in an image
.env
**/data
**/config.yaml
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# VCS, CI and tooling
.git
.gitignore
.githooks
.github
.vscode
.idea
.claude

# Docs and compose files -- not part of any image
doc
*.md
compose*.yaml
compose*.yml

# Logs and OS noise
**/*.log
.DS_Store
